{
  "main guard": {
    "prefix": "pmain",
    "body": [
      "if __name__ == \"__main__\":",
      "    ${1:main()}$0"
    ],
    "description": "if __name__ == '__main__'"
  },
  "dataclass": {
    "prefix": "pclass",
    "body": [
      "@dataclass",
      "class ${1:Name}:",
      "    ${2:field}: ${3:str}$0",
      "",
      "    def ${4:__post_init__(self):}",
      "        $5"
    ],
    "description": "Clase dataclass con campos"
  },
  "test pytest": {
    "prefix": "ptest",
    "body": [
      "def test_${1:name}():",
      "    # arrange",
      "    ${2:value} = ${3:...}",
      "",
      "    # act",
      "    ${4:result} = ${5:...}",
      "",
      "    # assert",
      "    assert ${4:result} == ${6:expected}$0"
    ],
      "description": "Test pytest con patrón arrange/act/assert"
  },
  "fixture pytest": {
    "prefix": "pfixture",
    "body": [
      "@pytest.fixture",
      "def ${1:name}(${2}):",
      "    $0",
      "    yield ${3:value}"
    ],
    "description": "Fixture pytest con yield"
  },
  "with open": {
    "prefix": "popen",
    "body": [
      "with open(${1:path}, \"${2:r}\", encoding=\"${3:utf-8}\") as ${4:f}:",
      "    ${5:content} = ${4:f}.read()$0"
    ],
    "description": "Apertura segura de archivos"
  },
  "try / except / logging": {
    "prefix": "ptry",
    "body": [
      "try:",
      "    ${1:...}",
      "except ${2:Exception} as ${3:e}:",
      "    logger.error(\"${4:Fallo en %s}: %s\", \"${5:operacion}\", ${3:e})",
      "    ${6:raise}$0",
      "else:",
      "    $0",
      "finally:",
      "    $0"
    ],
    "description": "try/except con logging"
  },
  "argparse": {
    "prefix": "parg",
    "body": [
      "parser = argparse.ArgumentParser(description=\"${1:Descripción}\")",
      "parser.add_argument(\"${2:name}\", help=\"${3:Ayuda}\")",
      "parser.add_argument(\"--${4:flag}\", action=\"store_true\", help=\"${5:Ayuda}\")",
      "args = parser.parse_args()$0"
    ],
    "description": "CLI básica con argparse"
  },
  "async def": {
    "prefix": "pasync",
    "body": [
      "async def ${1:name}(${2}) -> ${3:None}:",
      "    ${4:...} = await ${5:...}$0"
    ],
    "description": "Corrutina con await"
  },
  "if type hint": {
    "prefix": "pdecl",
    "body": "${1:name}: ${2:list[str]} = ${3:[]}$0",
    "description": "Variable con anotación de tipo"
  }
}
